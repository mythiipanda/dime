NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=z-ai/glm-5.3-flash
# Tony-approved: his AI Studio free tier (free-tier quotas unverified:
# screenshot only; confirm from a live API response before publishing numbers).
# Live models: gemini-3.5-flash-lite (workhorse default), gemini-3.5-flash.
# Do NOT configure Pro models here (0 free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Copy to backend/.env and fill in. Never commit the real file.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5
# Optional: Reader works keyless at 20 RPM; a free key raises it to 500 RPM.
JINA_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dime-fawn.vercel.app,http://127.0.0.1:3000

# Optional v2 persistence locations. Defaults live under backend/data/.
DIME_V2_LEDGER_DIR=
DIME_V2_CHECKPOINT_DIR=

DIME_V2_SHADOW_STORE=
DIME_V2_SHADOW_TIMEOUT_SECONDS=480
DIME_V2_SHADOW_MAX_INFLIGHT=8

# Experimental TypeSafe Jev adapter. Disabled by default.
DIME_JEV_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=2
DIME_JEV_SHADOW_LOG=

# Explicit paid-provider policy gate; a retained key alone never activates it.
DIME_ENABLE_INCEPTION=false
